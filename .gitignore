# live-build output/cache (regenerated by `lb build`, never commit)
config/chroot/
config/binary/
config/cache/
config/.build/
config/.lock
config/binary.modified_timestamps
config/chroot.files
config/chroot.packages.install
config/chroot.packages.live
config/live-image-*.contents
config/live-image-*.files
config/live-image-*.packages
config/chroot.installed_tmp_pkgs
config/installer_firmware_details.txt
*.iso
*.iso.zsync
*.build.log

# roadmap kept local-only, not on the public repo
ROADMAP.md
Venu-Pacific-Roadmap.html
Venu-Pacific-Roadmap.pdf

# package build output (scripts/build-debs.sh) and the signed apt archive
# assembled from it (scripts/apt-repo/publish.sh)
dist/
debian/venu-pacific-*/
debian/mo/
debian/files
debian/*.substvars
debian/*.debhelper
debian/*.debhelper.log
debian/debhelper-build-stamp
debian/.debhelper/

# the .debs live-build installs into the image — build output, rebuilt by
# scripts/build-debs.sh before every `lb build`
config/config/packages.chroot/*.deb

# local R2 settings (account id, bucket, profile) — r2.env.example is the
# committed template. Not a secret the way the API key is, but it identifies
# the Cloudflare account and has no business in a public repo.
scripts/apt-repo/r2.env

# NEVER commit the archive's PRIVATE signing key. Its public half
# (scripts/apt-repo/keys/venu-pacific-archive-keyring.gpg) is committed on
# purpose — it ships in venu-pacific-archive-keyring — but anyone holding
# the secret half can sign packages every installed machine will trust.
*.gpg.key
*.private.asc
scripts/apt-repo/keys/*secret*

# editor / OS cruft
.DS_Store
*.swp
*~
__pycache__/
*.pyc
config/build.log
