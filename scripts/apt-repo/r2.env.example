# Copy to r2.env and fill in. publish.sh reads it automatically, so the
# account id never has to be typed or remembered again:
#
#     cp scripts/apt-repo/r2.env.example scripts/apt-repo/r2.env
#
# R2_ACCOUNT_ID is the host part of the bucket's S3 API endpoint --
# Cloudflare dashboard -> R2 -> venu-pacific-releases -> Settings -> S3 API,
# where the endpoint reads https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#
# It is NOT the hash in the old pub-<hash>.r2.dev development URL. Those are
# different identifiers, and confusing them is why this file exists.
R2_ACCOUNT_ID=
R2_BUCKET=venu-pacific-releases
AWS_PROFILE=r2
