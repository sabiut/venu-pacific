#!/bin/sh
# Takes light-locker's autostart entry out of play.
#
# XFCE autostarts light-locker directly via
# /etc/xdg/autostart/light-locker.desktop. We want the session to start
# venu-pacific-light-locker-guard instead, which decides whether locking is
# appropriate on this hardware before handing over. Both entries running
# would mean two screen lockers competing for the same session.
#
# So light-locker's entry is diverted out of the autostart directory
# entirely, and our own entry -- venu-pacific-screen-locker.desktop, a file
# only this package owns -- takes its place.
#
# Two earlier approaches failed, both in ways worth recording:
#
#   1. Shipping our copy AT light-locker's path. Two packages cannot own the
#      same file; dpkg refused the unpack outright and took the whole image
#      build down with it.
#   2. Same path, plus a diversion excluding this package. That cleared the
#      ownership conflict, but the path is under /etc, so dpkg treats it as a
#      conffile -- and stopped to ask the administrator which copy to keep.
#      An interactive prompt is not something an unattended image build can
#      answer, so configuration failed instead.
#
# Diverting light-locker's file while shipping ours under a different name
# avoids both: no shared path, no contested conffile.
#
# In the PREINST because the diversion has to exist before dpkg unpacks
# anything into that directory.
set -e

DESKTOP=/etc/xdg/autostart/light-locker.desktop

case "$1" in
    install|upgrade)
        dpkg-divert --add --rename --divert "$DESKTOP.distrib" "$DESKTOP"
        ;;
esac

#DEBHELPER#

exit 0
