#!/bin/sh
# Stamps the release version into /usr/lib/os-release (which /etc/os-release
# symlinks to), so `cat /etc/os-release`, neofetch, GRUB's os-prober and the
# XFCE about dialog all name the running release.
#
# This used to be a live-build hook, which meant the number was only ever
# correct for the image as first built: a machine that had since upgraded
# from 26.08 to 26.09 through apt still announced 26.08, and every bug
# report from it named the wrong version. Doing it from the metapackage's
# postinst means the stamp follows the upgrade.
#
# Replaces the branding fields only. ID and VERSION_CODENAME are left as
# genuine Debian values on purpose: other packages' scripts check ID=debian
# for compatibility logic, and apt itself relies on VERSION_CODENAME=trixie
# staying correct.
#
# This consolidates what used to be two live-build hooks that fought each
# other -- 0150 wrote a PRETTY_NAME without a version, 0190 wrote one with,
# and which won depended on filename ordering.
#
# os-release belongs to base-files, so a base-files upgrade will wipe these
# lines. That is why the whole edit is idempotent and re-applied on every
# configure rather than done once.
set -e

case "$1" in
    configure)
        VERSION="$(dpkg-query -W -f='${Version}' venu-pacific-desktop 2>/dev/null || true)"
        [ -n "$VERSION" ] || exit 0

        # /etc/os-release is normally a symlink to /usr/lib/os-release, but
        # not on every system -- handle both without writing the file twice.
        for f in /usr/lib/os-release /etc/os-release; do
            [ -f "$f" ] || continue
            [ -L "$f" ] && continue

            tmp="$(mktemp)"
            # Drop any stamp from a previous run, then re-add. Matching on
            # our own field names only -- everything else in the file is
            # base-files' and is copied through untouched.
            grep -v -E '^(VARIANT|VARIANT_ID|VENU_PACIFIC_VERSION)=' "$f" > "$tmp"
            sed -i \
                -e "s|^PRETTY_NAME=.*|PRETTY_NAME=\"Venu Pacific ${VERSION} (Debian 13/trixie base)\"|" \
                -e 's|^NAME=.*|NAME="Venu Pacific"|' \
                -e 's|^HOME_URL=.*|HOME_URL="https://venupacific.org"|' \
                "$tmp"
            {
                echo "VARIANT=\"Venu Pacific\""
                echo "VARIANT_ID=venu-pacific"
                echo "VENU_PACIFIC_VERSION=\"${VERSION}\""
            } >> "$tmp"

            chmod 0644 "$tmp"
            cat "$tmp" > "$f"
            rm -f "$tmp"
        done
        ;;
esac

#DEBHELPER#

exit 0
