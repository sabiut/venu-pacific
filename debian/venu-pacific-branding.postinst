#!/bin/sh
# Registers Venu Pacific's look through the same mechanisms the live-build
# hooks used to run at image-build time (0100-venu-pacific-plymouth,
# 0110-venu-pacific-default-wallpaper). Doing it here rather than in a hook
# is what lets a wallpaper or boot-splash change reach an already-installed
# machine through apt.
set -e

case "$1" in
    configure)
        # Both tools below belong to other packages (desktop-base and
        # plymouth), and both are Depends rather than Recommends precisely so
        # that dpkg configures them before this runs. As Recommends they were
        # configured after this package in a single apt transaction, and
        # calling plymouth-set-default-theme against a half-configured
        # plymouth left plymouth stuck at "unpacked" -- see debian/control.

        # The standard Debian mechanism derivatives use to rebrand the
        # default desktop look: /usr/share/images/desktop-base/desktop-background
        # is the well-known path other tooling reads, resolved through
        # update-alternatives. Priority 100 beats desktop-base's stock
        # ceratopsian-theme, which ships at 65 in trixie.
        update-alternatives --install \
            /usr/share/images/desktop-base/desktop-background \
            desktop-background \
            /usr/share/backgrounds/venu-pacific/volcano-wave.png \
            100

        # Selecting the boot theme rebuilds the initramfs, which is slow and
        # pointless if this theme is already the active one -- so only act
        # when it is not.
        if [ "$(plymouth-set-default-theme 2>/dev/null)" != "venu-pacific" ]; then
            plymouth-set-default-theme venu-pacific --rebuild-initrd
        fi
        ;;
esac

#DEBHELPER#

exit 0
