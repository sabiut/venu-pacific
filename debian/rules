#!/usr/bin/make -f
#
# Venu Pacific's own packages.
#
# Deliberately explicit rather than driven by debian/*.install files: the
# payload does not sit in a conventional upstream layout. It lives in the
# working directories people actually edit (welcome-app/, hub/, branding/,
# locales/, system/, ...), and several files change path or content on the
# way in -- .po becomes .mo, and the release version is substituted from
# debian/changelog. Writing those moves out in one readable place beats
# spreading them across eight .install files plus a set of overrides.
#
# Note what is NOT here: no rewriting of /usr/local paths. The programs
# install to /usr/bin and /usr/sbin, and the source files say so directly --
# scripts/lint.sh fails the build if a /usr/local reference reappears.

export DH_VERBOSE = 1

VERSION := $(shell dpkg-parsechangelog -SVersion)

# Staging roots, one per binary package.
APPS      = debian/venu-pacific-apps
ASSISTANT = debian/venu-pacific-assistant
BRANDING  = debian/venu-pacific-branding
CONTENT   = debian/venu-pacific-content
DESKTOP   = debian/venu-pacific-desktop
KEYRING   = debian/venu-pacific-archive-keyring
L10N      = debian/venu-pacific-l10n
SETTINGS  = debian/venu-pacific-settings

# The exported archive signing public key. Generated by
# scripts/apt-repo/make-key.sh; deliberately NOT auto-created here, because
# silently building a keyring around a key nobody signs with would produce
# an archive that fails to verify on every user's machine at once.
ARCHIVE_KEY = scripts/apt-repo/keys/venu-pacific-archive-keyring.gpg

%:
	dh $@

override_dh_auto_build:
	# Compile the gettext catalogs. msgfmt is a build dependency, so a
	# broken catalog fails the package build rather than shipping.
	set -e; for po in locales/*/*.po; do \
	    [ -f "$$po" ] || continue; \
	    lang="$$(basename "$$(dirname "$$po")")"; \
	    domain="$$(basename "$$po" .po)"; \
	    mkdir -p "debian/mo/$$lang"; \
	    msgfmt --check "$$po" -o "debian/mo/$$lang/$$domain.mo"; \
	done

override_dh_auto_install:
	# ---- venu-pacific-apps ----------------------------------------
	install -D -m 0755 welcome-app/venu-pacific-welcome \
	    $(APPS)/usr/bin/venu-pacific-welcome
	install -D -m 0755 hub/venu-pacific-hub \
	    $(APPS)/usr/bin/venu-pacific-hub
	install -D -m 0755 disaster-info/venu-pacific-disaster-info \
	    $(APPS)/usr/bin/venu-pacific-disaster-info
	install -D -m 0755 services-directory/venu-pacific-services-directory \
	    $(APPS)/usr/bin/venu-pacific-services-directory
	install -D -m 0755 system/bin/venu-pacific-kolibri \
	    $(APPS)/usr/bin/venu-pacific-kolibri
	install -d $(APPS)/usr/share/applications
	install -m 0644 \
	    hub/venu-pacific-hub.desktop \
	    disaster-info/venu-pacific-disaster-info.desktop \
	    services-directory/venu-pacific-services-directory.desktop \
	    kiwix-content/venu-pacific-kiwix-content.desktop \
	    kiwix-content/venu-pacific-vikidia.desktop \
	    system/applications/venu-pacific-help.desktop \
	    system/applications/venu-pacific-kolibri.desktop \
	    system/applications/venu-pacific-phet.desktop \
	    system/applications/venu-pacific-wikipedia-bislama.desktop \
	    $(APPS)/usr/share/applications/
	install -D -m 0644 welcome-app/venu-pacific-welcome.desktop \
	    $(APPS)/etc/xdg/autostart/venu-pacific-welcome.desktop
	install -D -m 0644 kiwix-content/index.html \
	    $(APPS)/usr/share/venu-pacific/kiwix-content/index.html
	# The Help page shows the release version so a user can read it off
	# the screen when reporting a problem. Substituted from the changelog
	# here, at build time -- this used to be a live-build hook, which meant
	# the number only ever updated when a whole new image was built.
	install -D -m 0644 system/help/index.html \
	    $(APPS)/usr/share/venu-pacific/help/index.html
	sed -i 's/@VENU_VERSION@/$(VERSION)/g' \
	    $(APPS)/usr/share/venu-pacific/help/index.html

	# ---- venu-pacific-assistant ------------------------------------
	install -D -m 0755 ai-assistant/venu-pacific-assistant \
	    $(ASSISTANT)/usr/bin/venu-pacific-assistant
	install -D -m 0644 ai-assistant/venu-pacific-assistant.desktop \
	    $(ASSISTANT)/usr/share/applications/venu-pacific-assistant.desktop
	install -D -m 0644 system/systemd/user/venu-pacific-llama.service \
	    $(ASSISTANT)/usr/lib/systemd/user/venu-pacific-llama.service
	install -D -m 0644 system/systemd/user/venu-pacific-llama-prewarm.service \
	    $(ASSISTANT)/usr/lib/systemd/user/venu-pacific-llama-prewarm.service

	# ---- venu-pacific-content --------------------------------------
	install -D -m 0644 disaster-info/content/vanuatu.json \
	    $(CONTENT)/usr/share/venu-pacific/disaster-info/vanuatu.json
	install -D -m 0644 disaster-info/content/fiji.json \
	    $(CONTENT)/usr/share/venu-pacific/disaster-info/fiji.json
	install -D -m 0644 services-directory/content/vanuatu.json \
	    $(CONTENT)/usr/share/venu-pacific/services-directory/vanuatu.json
	install -D -m 0644 services-directory/content/fiji.json \
	    $(CONTENT)/usr/share/venu-pacific/services-directory/fiji.json

	# ---- venu-pacific-branding -------------------------------------
	install -d $(BRANDING)/usr/share/backgrounds/venu-pacific
	install -m 0644 branding/wallpapers/*.png \
	    $(BRANDING)/usr/share/backgrounds/venu-pacific/
	install -d $(BRANDING)/usr/share/plymouth/themes/venu-pacific
	install -m 0644 branding/plymouth/venu-pacific/* \
	    $(BRANDING)/usr/share/plymouth/themes/venu-pacific/
	# The app-menu/taskbar icon and the LightDM default user image are the
	# same 512px circle-cropped mark.
	install -D -m 0644 branding/logo/venu-mark-circle-512.png \
	    $(BRANDING)/usr/share/pixmaps/venu-pacific.png
	# Calamares branding. Only ever read in the live session, but shipped
	# from the package so the version string below has a single source.
	install -D -m 0644 system/calamares/branding.desc \
	    $(BRANDING)/etc/calamares/branding/venu-pacific/branding.desc
	install -D -m 0644 branding/logo/venu-mark-circle-256.png \
	    $(BRANDING)/etc/calamares/branding/venu-pacific/logo.png
	install -D -m 0644 branding/wallpapers/pacific-ocean.png \
	    $(BRANDING)/etc/calamares/branding/venu-pacific/slide1.png
	install -D -m 0644 branding/calamares/welcome.png \
	    $(BRANDING)/etc/calamares/branding/venu-pacific/welcome.png
	sed -i 's/@VENU_VERSION@/$(VERSION)/g' \
	    $(BRANDING)/etc/calamares/branding/venu-pacific/branding.desc

	# ---- venu-pacific-l10n -----------------------------------------
	set -e; for mo in debian/mo/*/*.mo; do \
	    [ -f "$$mo" ] || continue; \
	    lang="$$(basename "$$(dirname "$$mo")")"; \
	    install -D -m 0644 "$$mo" \
	        "$(L10N)/usr/share/locale/$$lang/LC_MESSAGES/$$(basename "$$mo")"; \
	done

	# ---- venu-pacific-settings -------------------------------------
	install -D -m 0755 system/bin/venu-pacific-set-defaults \
	    $(SETTINGS)/usr/bin/venu-pacific-set-defaults
	install -D -m 0755 system/bin/venu-pacific-light-locker-guard \
	    $(SETTINGS)/usr/bin/venu-pacific-light-locker-guard
	install -D -m 0755 system/bin/venu-pacific-notify-updates \
	    $(SETTINGS)/usr/bin/venu-pacific-notify-updates
	install -D -m 0755 system/sbin/venu-pacific-update-check \
	    $(SETTINGS)/usr/sbin/venu-pacific-update-check
	install -D -m 0644 system/systemd/system/venu-pacific-update-check.service \
	    $(SETTINGS)/usr/lib/systemd/system/venu-pacific-update-check.service
	install -D -m 0644 system/systemd/system/venu-pacific-update-check.timer \
	    $(SETTINGS)/usr/lib/systemd/system/venu-pacific-update-check.timer
	install -D -m 0644 system/systemd/user/venu-pacific-notify-updates.service \
	    $(SETTINGS)/usr/lib/systemd/user/venu-pacific-notify-updates.service
	install -D -m 0644 system/systemd/user/venu-pacific-notify-updates.timer \
	    $(SETTINGS)/usr/lib/systemd/user/venu-pacific-notify-updates.timer
	# Our screen-locker autostart entry, under OUR name. light-locker's own
	# entry is neutralised by a diversion in the preinst rather than
	# overwritten: shipping a file at light-locker's path made dpkg treat
	# it as a contested conffile and stop to ask the admin which copy to
	# keep -- a prompt no unattended image build can answer.
	install -D -m 0644 system/autostart/venu-pacific-screen-locker.desktop \
	    $(SETTINGS)/etc/xdg/autostart/venu-pacific-screen-locker.desktop
	install -D -m 0644 system/autostart/venu-pacific-set-defaults.desktop \
	    $(SETTINGS)/etc/xdg/autostart/venu-pacific-set-defaults.desktop
	install -D -m 0644 system/skel/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-desktop.xml \
	    $(SETTINGS)/etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-desktop.xml
	install -D -m 0644 system/skel/.config/xfce4/xfconf/xfce-perchannel-xml/xfwm4.xml \
	    $(SETTINGS)/etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml/xfwm4.xml
	# /etc/issue and /etc/issue.net belong to base-files. Shipping them
	# from a second package is a file conflict dpkg refuses outright, so
	# these go in as templates and the postinst installs them over the
	# stock banner (keeping one backup, restored on purge).
	install -D -m 0644 system/etc/issue \
	    $(SETTINGS)/usr/share/venu-pacific/issue
	install -D -m 0644 system/etc/issue.net \
	    $(SETTINGS)/usr/share/venu-pacific/issue.net

	# ---- venu-pacific-archive-keyring ------------------------------
	@if [ ! -f $(ARCHIVE_KEY) ]; then \
	    echo; \
	    echo "ERROR: $(ARCHIVE_KEY) is missing."; \
	    echo "Generate the archive signing key first:"; \
	    echo "    ./scripts/apt-repo/make-key.sh"; \
	    echo; \
	    exit 1; \
	fi
	install -D -m 0644 $(ARCHIVE_KEY) \
	    $(KEYRING)/usr/share/keyrings/venu-pacific-archive-keyring.gpg
	install -D -m 0644 debian/venu-pacific.sources \
	    $(KEYRING)/etc/apt/sources.list.d/venu-pacific.sources

	# ---- venu-pacific-desktop --------------------------------------
	# One authoritative answer to "which build is this?", derived from the
	# changelog rather than typed a second time.
	install -d $(DESKTOP)/etc
	echo "Venu Pacific $(VERSION)" > $(DESKTOP)/etc/venu-pacific-release
	chmod 0644 $(DESKTOP)/etc/venu-pacific-release

override_dh_installsystemd:
	# --no-start, applied to everything. venu-pacific-update-check.service
	# is a timer-activated oneshot, and "starting" it at install time would
	# run an apt index refresh in the middle of the installation -- during
	# the image build that means inside the chroot, over whatever network
	# the builder happens to have. Enabling the timer is the whole job; it
	# fires on its own schedule from the next boot.
	dh_installsystemd --no-start

override_dh_installsystemduser:
	# Per-user units, enabled globally for every account -- same reasoning
	# as the "systemctl --global enable" this replaces.
	dh_installsystemduser

override_dh_auto_clean:
	rm -rf debian/mo
