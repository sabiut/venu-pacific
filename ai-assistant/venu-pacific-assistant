# A PAIRED $...$ is a math delimiter; a lone "$48" is money. Requiring a real
# math tell between the pair means "it costs $5 and then $10 more" survives
# untouched -- two dollar signs, but nothing between them that could be an
# equation. The earlier version of this only handled "$ " followed by
# whitespace, which left "$x^2$" showing its delimiters on screen.
_MATH_TELL = re.compile(r"[\\^_{}=]|\b\d+\s*[+\u00d7\u00f7/*-]\s*\d+")
# "$2x + 3$" is obviously an equation but has none of the tells above -- the
# variable breaks the digit-operator-digit pattern. What separates it from
# prose is that prose contains words: "5 and then " (from "it costs $5 and
# then $10 more") has "and" and "then", while an expression is made of short
# tokens. So a short pair with no run of three or more letters is maths.
_PROSE_WORD = re.compile(r"[A-Za-z]{3,}")
_DOLLAR_PAIR = re.compile(r"\$\$?([^$\n]{1,80}?)\$\$?")


def _to_script(body, table, prefix):
    """Unicode super/subscript, but only when EVERY character has one.
    Half-converted output (x\u00b2 followed by a plain "y" that had no
    superscript form) reads worse than not converting at all, so this is all
    or nothing, with an ASCII fallback that stays unambiguous."""
    if body and all(ch in table for ch in body):
        return "".join(table[ch] for ch in body)
    return "{}({})".format(prefix, body) if len(body) > 1 else prefix + body


# Display-mode delimiters on their own line ("$$" above and below a
# formula, or \[ and \]). _DOLLAR_PAIR cannot see these because it stops
# at a newline, so they used to reach the screen as two bare "$$" lines
# around an otherwise converted formula -- seen for real on the quadratic
# formula in scripts/eval-assistant.py.
_DISPLAY_MATH_LINE = re.compile(r"^[ \t]*(?:\$\$|\\\[|\\\])[ \t]*\n?", re.M)


def _strip_math_delimiters(text):
    text = _DISPLAY_MATH_LINE.sub("", text)
    text = re.sub(r"\\\((.+?)\\\)", lambda m: m.group(1).strip(), text)

    def repl(match):
        inner = match.group(1)
        stripped = inner.strip()
        # Content ending mid-operator is not a delimited expression, it is
        # the gap between two prices: "$112.50 - $17.00" makes the regex see
        # a pair whose contents are "112.50 -", which has no words in it and
        # would otherwise look like maths. The closing $ there belongs to
        # the NEXT number, not to this one.
        if re.search(r"[-+*/\u00d7\u00f7=]\s*$", stripped):
            return match.group(0)
        if (_MATH_TELL.search(inner)
                or (" " not in stripped and len(inner) <= 14)
                or (len(stripped) <= 40 and not _PROSE_WORD.search(stripped))):
            # The stripped form, not the raw inner text: "$ a $, $ b $" is
            # how the model pads its delimiters, and keeping that padding
            # detached every following comma and full stop ("a , b , and
            # c", "= 0 .") on screen.
            return stripped
        return match.group(0)
    return _DOLLAR_PAIR.sub(repl, text)


def _read_braced_group(text, index):
    """Contents of the {...} starting at index, and the index just past its
    closing brace. Returns (None, index) if there is no balanced group."""
    if index >= len(text) or text[index] != "{":
        return None, index
    depth = 0
    for position in range(index, len(text)):
        if text[position] == "{":
            depth += 1
        elif text[position] == "}":
            depth -= 1
            if depth == 0:
                return text[index + 1:position], position + 1
    return None, index


def _expand_braced_commands(text):
    r"""Expand \frac and \sqrt, counting braces properly.

    This cannot be a regular expression. The obvious pattern uses [^{}]* for
    each argument, which silently fails the moment an argument contains
    braces of its own -- and the single most common formula anyone asks for
    does exactly that: \frac{-b \pm \sqrt{b^2-4ac}}{2a}. The match failed,
    \frac fell through to the generic backslash-stripping rule, and the
    quadratic formula reached the user as "frac-b ± √(b² - 4ac)2a".

    Arguments are expanded recursively, innermost first, so a root inside a
    fraction comes out right.
    """
    out = []
    index = 0
    while index < len(text):
        matched = False
        for command in (r"\dfrac", r"\tfrac", r"\frac"):
            if text.startswith(command, index):
                cursor = index + len(command)
                while cursor < len(text) and text[cursor] == " ":
                    cursor += 1
                numerator, cursor = _read_braced_group(text, cursor)
                if numerator is None:
                    break
                while cursor < len(text) and text[cursor] == " ":
                    cursor += 1
                denominator, cursor = _read_braced_group(text, cursor)
                if denominator is None:
                    break
                numerator = _expand_braced_commands(numerator).strip()
                denominator = _expand_braced_commands(denominator).strip()
                if not re.fullmatch(r"[\w.]+", numerator):
                    numerator = "({})".format(numerator)
                # The denominator is bracketed unless it is a single
                # character: "(-b ± √(b²-4ac))/2a" reads as .../2 times a to
                # anyone applying the precedence rules, and this is a machine
                # for teaching them.
                if not re.fullmatch(r"[\w.]", denominator):
                    denominator = "({})".format(denominator)
                out.append("{}/{}".format(numerator, denominator))
                index = cursor
                matched = True
                break
        if matched:
            continue
        if text.startswith(r"\sqrt", index):
            cursor = index + len(r"\sqrt")
            while cursor < len(text) and text[cursor] == " ":
                cursor += 1
            argument, cursor = _read_braced_group(text, cursor)
            if argument is not None:
                argument = _expand_braced_commands(argument).strip()
                if not re.fullmatch(r"[\w.]+", argument):
                    argument = "({})".format(argument)
                out.append("\u221a" + argument)
                index = cursor
                continue
        out.append(text[index])
        index += 1
    return "".join(out)


def _prettify_math(text):
    """Turn the LaTeX small local models reach for into readable Unicode.

    Confirmed in practice: asked anything numeric, the model emits
    \\frac{1}{2}, x^{2}, \\times, $...$ and friends even when the prompt
    asks for plain text. The chat view is a GTK label with no math
    typesetting, so that used to reach the user as literal backslashes and
    braces -- "the arithmetic signs are all over the place", as the pilot
    testing put it.

    Prompt-side discouragement stays (SYSTEM_PROMPT), because the cheapest
    fix is the model not emitting it; this is what happens when it does
    anyway, which is often.
    """
    text = _strip_math_delimiters(text)

    # Presentation-only wrappers: unwrap, keep the contents.
    text = re.sub(r"\\(?:text|mathrm|mathbf|mathit|operatorname)\s*\{([^{}]*)\}",
                  r"\1", text)
    text = text.replace(r"\left", "").replace(r"\right", "")

    text = _expand_braced_commands(text)

    # Longest names first so \leq is not eaten by \le.
    for name in sorted(_LATEX_SYMBOLS, key=len, reverse=True):
        text = text.replace(name, _LATEX_SYMBOLS[name])

    # Whatever \word is left is a function name written the LaTeX way
    # (\sin, \cos, \log, \lim). Drop the backslash, keep the word.
    text = re.sub(r"\\([A-Za-z]+)", r"\1", text)

    text = re.sub(r"\^\{([^{}]+)\}",
                  lambda m: _to_script(m.group(1), _SUPERSCRIPT, "^"), text)
    text = re.sub(r"_\{([^{}]+)\}",
                  lambda m: _to_script(m.group(1), _SUBSCRIPT, "_"), text)
    text = re.sub(r"\^(-?\w)",
                  lambda m: _to_script(m.group(1), _SUPERSCRIPT, "^"), text)
    text = re.sub(r"_(-?\w)",
                  lambda m: _to_script(m.group(1), _SUBSCRIPT, "_"), text)

    text = re.sub(r"\\[(){}\[\]!,;]|\\quad|\\qquad", " ", text)
    text = re.sub(r"\{([^{}]*)\}", r"\1", text)      # leftovers like 3{,}750
    text = re.sub(r"(?<=[\d)])\s\*\s(?=[\d(])", " \u00d7 ", text)
    text = re.sub(r"[ \t]{2,}", " ", text)

    # Models frequently write a numbered list as one running paragraph:
    # "1. Differentiate x^2: ... is 2x. 2. Differentiate 3x: ... is 3."
    # On screen that reads as arithmetic gone wrong -- "is 2x. 2." looks
    # like part of the equation. Put each step on its own line. Requires a
    # capital after the number, so a decimal split across a sentence
    # boundary ("... is 3. 5 apples remain") is not mistaken for a list.
    text = re.sub(r"(?<=[.:])[ \t]+(?=\d{1,2}\.\s+[A-Z])", "\n", text)

    # Same again for dash and asterisk bullets, which models write inline
    # just as readily: "Where: - A is the amount ... - P is the principal
    # ... - r is the annual rate" arrives as one unreadable paragraph.
    # Anchored on a preceding "." or ":" so a subtraction ("$112.50 - $17.00",
    # "5 - 3") is never mistaken for a bullet -- those have a digit before
    # the dash, not a sentence ending. "* " needs the space, so it cannot
    # collide with the "**" of bold.
    text = re.sub(r"(?<=[.:])[ \t]+(?=[-*]\s+[A-Za-z])", "\n", text)
    return text


