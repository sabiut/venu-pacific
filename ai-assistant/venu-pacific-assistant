    def on_attach_file(self, *_args):
        """Paperclip button: pick a file, drop a read-this-file request into
        the entry. The user still writes (or edits) the actual question and
        presses send themselves -- attaching never auto-sends, so they can
        ask something specific about the file rather than a generic
        analysis. Reading happens through the normal read_file tool, so the
        home-directory sandbox and the PDF text extraction both apply
        unchanged."""
        dialog = Gtk.FileChooserDialog(
            title=_("Choose a file for the assistant to read"),
            transient_for=self,
            action=Gtk.FileChooserAction.OPEN,
        )
        dialog.add_button(_("Cancel"), Gtk.ResponseType.CANCEL)
        dialog.add_button(_("Open"), Gtk.ResponseType.OK)
        dialog.set_current_folder(HOME_DIR)

        doc_filter = Gtk.FileFilter()
        doc_filter.set_name(_("Documents (PDF and text)"))
        for pattern in ("*.pdf", "*.txt", "*.md", "*.csv", "*.log"):
            doc_filter.add_pattern(pattern)
        dialog.add_filter(doc_filter)
        all_filter = Gtk.FileFilter()
        all_filter.set_name(_("All files"))
        all_filter.add_pattern("*")
        dialog.add_filter(all_filter)

        response = dialog.run()
        path = dialog.get_filename() if response == Gtk.ResponseType.OK else None
        dialog.destroy()
        if path:
            self._insert_file_reference(path)

    def _insert_file_reference(self, path):
        """Separate from the dialog handler so it can be tested without a
        file-chooser on screen."""
        resolved = os.path.realpath(path)
        if resolved != HOME_DIR and not resolved.startswith(HOME_DIR + os.sep):
            # Same boundary the read_file tool enforces -- catching it here
            # gives actionable advice instead of a later tool refusal. USB
            # sticks mount under /media, so this is the exact message a
            # teacher with a worksheet on a stick needs.
            self._add_message(
                _(
                    "That file is outside your Home folder, so the assistant "
                    "can't read it. Copy it into your Home folder (for "
                    "example into Documents) and attach it from there."
                ),
                is_user=False,
            )
            return
        self.entry.set_text(
            _("Please read this file and tell me about it: {path}").format(path=resolved)
        )
        self.entry.set_position(-1)
        self.entry.grab_focus()

    def _start_server_async(self):
        self._server_starting = True
        self._server_start_time = time.time()
        self.retry_button.hide()
        self.startup_logo.show()
        GLib.timeout_add(1000, self._tick_starting_label)

        def worker():
            try:
                self.server.start()
                self.server.wait_ready()
            except AssistantStartupError as exc:
                # Kill whatever's left of this attempt (e.g. a still-loading
                # llama-server that just ran out of patience) rather than
                # leave it running in the background until the window is
                # closed -- matters now that "Try again" can retry without
                # closing the window at all.
                self.server.stop()
                GLib.idle_add(self._on_server_ready, str(exc))
                return
            except Exception as exc:  # noqa: BLE001 -- must never fail silently here
                self.server.stop()
                GLib.idle_add(self._on_server_ready, str(exc))
                return
            GLib.idle_add(self._on_server_ready, None)

        threading.Thread(target=worker, daemon=True).start()

    def _tick_starting_label(self):
        """Ticks the "Starting..." label with elapsed seconds so a slow
        cold-cache model load (see STARTUP_TIMEOUT_SECONDS) doesn't look
        like the app has frozen for up to a few minutes."""
        if not self._server_starting:
            return False
        elapsed = int(time.time() - self._server_start_time)
        self.status_label.set_text(_("Starting the assistant… ({elapsed}s)").format(elapsed=elapsed))
        return True

    def on_retry_start(self, *_args):
        self._start_server_async()

    def _on_server_ready(self, error):
        self._server_starting = False
        self.startup_logo.hide()
        if error is None:
            self.status_label.set_text(_("Ready. Ask a question below."))
            self.retry_button.hide()
            self.entry.set_sensitive(True)
            self.send_button.set_sensitive(True)
            self.attach_button.set_sensitive(True)
            self.new_chat_button.set_sensitive(True)
            self.conversation_list.set_sensitive(True)
            self.entry.grab_focus()
            # Start evaluating the fixed prompt prefix in the background
            # while the user is still reading/typing -- see prewarm_prefix.
            # Deliberately after the UI is marked ready, never gating it.
            # The gate is closed HERE, synchronously on the main thread,
            # before the thread starts -- clearing it inside the thread
            # would leave a window where a fast user send slips past the
            # gate before the thread gets scheduled, recreating the exact
            # queued-behind-prewarm timeout this prevents.
            _prewarm_done.clear()
            threading.Thread(target=prewarm_prefix, daemon=True).start()
        else:
            self.status_label.set_text(_("Could not start the assistant: {error}").format(error=error))
            self.retry_button.show()
        return False

    def _build_code_block(self, code, language):
        """A fenced code block: language tag, copy button, and the source in
        a monospace label that scrolls sideways rather than wrapping.

        Deliberately NOT wrapped. Every other message body is pre-wrapped
        with literal newlines to stop the window growing (see _add_message),
        but doing that to code would change the code -- a wrapped line is a
        different program, and the user is likely to copy this straight into
        an editor. Horizontal scrolling keeps it exact and still keeps the
        window from being dragged wide by one long line.
        """
        frame = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        frame.get_style_context().add_class("code-block")

        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        tag = Gtk.Label(label=(language or _("code")).upper(), xalign=0)
        tag.get_style_context().add_class("code-lang")
        header.pack_start(tag, False, False, 0)

        copy_button = Gtk.Button(label=_("Copy"))
        copy_button.get_style_context().add_class("code-copy")
        copy_button.set_relief(Gtk.ReliefStyle.NONE)
        # The raw source, never the marked-up version -- pasting Pango span
        # tags into an editor would be worse than useless.
        copy_button.connect("clicked", self._on_copy_code, code, copy_button)
        header.pack_end(copy_button, False, False, 0)
        frame.pack_start(header, False, False, 0)

        label = Gtk.Label(xalign=0)
        label.set_markup(_code_markup(code, language))
        label.set_selectable(True)
        # set_selectable turns can_focus on, and the first focusable widget
        # in a newly shown container appears with all its text selected --
        # a blue highlight across the reply the user has to click away.
        # Mouse selection still works with focus off; keyboard traversal
        # just skips the label, which is what we want anyway.
        label.set_can_focus(False)
        label.get_style_context().add_class("code-text")

        scroller = Gtk.ScrolledWindow()
        scroller.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.NEVER)
        scroller.set_propagate_natural_height(True)
        # Without a minimum, the scroller takes its natural width from
        # nothing and collapses: a reply that was ONLY a code block came out
        # about 100px wide with every line cut off mid-token. 420px is a
        # readable line of code and still fits the 1366px screens this is
        # built for.
        scroller.set_min_content_width(420)
        scroller.add(label)
        frame.pack_start(scroller, False, False, 0)
        return frame

    def _on_copy_code(self, _button, code, button):
        Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD).set_text(code, -1)
        # Confirm in the button itself: there is no toast/notification
        # surface in this window, and silently copying gives the user no way
        # to know it worked.
        button.set_label(_("Copied"))
        GLib.timeout_add(1500, lambda: (button.set_label(_("Copy")), False)[1])

    def _render_message_body(self, text):
        """The assistant's reply as a stack of prose and code blocks inside
        one bubble. Returns the bubble widget.

        A single Gtk.Label cannot do this: code needs a monospace font,
        syntax colour and no wrapping, while prose needs the opposite. One
        bubble containing several widgets keeps it looking like a single
        message rather than a run of separate ones.
        """
        bubble = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        bubble.get_style_context().add_class("message-assistant")

        blocks = _split_message_blocks(text)
        if not blocks:
            blocks = [("prose", text)]
        for block in blocks:
            if block[0] == "code":
                bubble.pack_start(self._build_code_block(block[2], block[1]),
                                  False, False, 0)
                continue
            markup = _prose_markup(block[1])
            if not markup.strip():
                continue
            label = Gtk.Label(xalign=0)
            # set_markup can raise on malformed markup; the reply matters
            # more than the styling, so fall back to showing it plainly.
            try:
                label.set_markup(markup)
            except Exception:
                label.set_text(_wrap_message_text(_prettify_math(block[1])))
            label.set_selectable(True)
            label.set_can_focus(False)   # see _build_code_block
            label.set_line_wrap(True)
            label.set_line_wrap_mode(Gtk.WrapMode.WORD_CHAR)
            bubble.pack_start(label, False, False, 0)

        # NO translate-to-Bislama/Fijian buttons here, and that is a
        # decision, not an omission. They shipped in 26.08.14 and were
        # pulled one version later: pilot testing showed the model cannot
        # actually translate into either language -- Fijian came out with
        # Samoan morphology (fa'a- prefixes), and Bislama parroted
        # whatever example phrases the prompt contained instead of
        # translating the text. Verified against the real model with
        # few-shot prompts built from the reviewed .po catalogs and
        # Qwen's recommended sampling; prompting does not create a
        # capability the model lacks. A dedicated button endorses its
        # output in a way free-form chat (covered by the header
        # disclaimer) does not -- and a confident wrong-language
        # rendering of cyclone-safety text is worse than no button.
        # Revisit only after a model that demonstrably handles bi/fj
        # lands (test with locales/*/venu-pacific.po pairs first).
        return bubble

    def _add_message(self, text, is_user, is_thinking=False):
        column = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        column.set_halign(Gtk.Align.END if is_user else Gtk.Align.START)

        # .upper() here since GTK's CSS engine doesn't support text-transform
        # (that's a web-CSS-only property) -- the uppercase styling has to
        # happen in Python instead.
        role_text = (_("You") if is_user else _("Assistant")).upper()
        role = Gtk.Label(label=role_text, xalign=1 if is_user else 0)
        role.get_style_context().add_class("role-label")
        role.get_style_context().add_class("role-user" if is_user else "role-assistant")
        column.pack_start(role, False, False, 0)

        # GtkLabel's own wrap/max-width-chars/size-request mechanisms were
        # each tried and each failed to reliably stop the window from
        # growing to fit long replies (confirmed against the real live
        # session, not just local guessing). Sidestepping the problem
        # entirely: pre-wrap the text ourselves with literal newlines before
        # it ever reaches the label, so there is no negotiation for GTK to
        # get wrong -- the label just displays lines that are already short.
        # An assistant message that is not still streaming gets the full
        # prose/code rendering. This covers reloading a saved conversation
        # too -- without it, scrolling back through history showed raw ```
        # fences and LaTeX where the live reply had shown formatted output.
        if not is_user and not is_thinking:
            body = self._render_message_body(text)
            column.pack_start(body, False, False, 0)
            self.chat_box.pack_start(column, False, False, 0)
            column.show_all()
            return body

        label = Gtk.Label(label=_wrap_message_text(text), xalign=0, wrap=True)
        label.set_selectable(True)
        label.set_line_wrap_mode(Gtk.WrapMode.WORD_CHAR)
        if is_thinking:
            label.get_style_context().add_class("message-thinking")
            # Small pulsing logo next to "Thinking..." -- same heartbeat
            # widget used on the startup screen, so waiting for a reply and
            # waiting for the assistant to start read as the same kind of
            # "working on it" state. Stashed on the label itself so
            # _on_reply can find and stop it once the real reply lands,
            # without needing to thread a second reference through on_send.
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
            logo = PulsingLogo(size=18)
            row.pack_start(logo, False, False, 0)
            row.pack_start(label, False, False, 0)
            label.pulsing_logo = logo
            # _on_reply replaces this whole streaming label with rendered
            # prose/code blocks once the full text has arrived, so it needs
            # a handle on the container to swap into.
            label.message_column = column
            column.pack_start(row, False, False, 0)
        else:
            label.get_style_context().add_class("message-user" if is_user else "message-assistant")
            label.message_column = column
            column.pack_start(label, False, False, 0)

        self.chat_box.pack_start(column, False, False, 0)
        column.show_all()
        return label

    def _scroll_to_bottom(self):
        adj = self.scroller.get_vadjustment()
        adj.set_value(adj.get_upper())
        return False

    def on_send(self, *_args):
        text = self.entry.get_text().strip()
        if not text:
            return
        self.entry.set_text("")
        self.entry.set_sensitive(False)
        self.send_button.set_sensitive(False)
        self.attach_button.set_sensitive(False)
        # Freeze conversation navigation while a reply is in flight. Switching
        # conversations, starting a new chat, or deleting the current one
        # mid-generation would swap self.history/current_conv_id under the
        # worker and destroy the thinking bubble it streams into -- the reply
        # would then be appended and SAVED into whichever conversation the
        # user switched to (verified: two clicks were enough to corrupt a
        # stored conversation this way). One in-flight turn at a time is
        # already this app's model (entry + send are disabled the same way).
        self.new_chat_button.set_sensitive(False)
        self.conversation_list.set_sensitive(False)
        # Belt-and-braces: also capture which conversation this turn belongs
        # to at send time, so _on_reply files the exchange where it started
        # even if some future code path unfreezes navigation.
        conv_id_at_send = self.current_conv_id
        history_at_send = self.history
        if not self.history:
            # First message of a fresh view (either app startup's "Ready"
            # placeholder or the "New conversation" placeholder) -- clear it
            # so it doesn't linger above the real conversation.
            self._clear_chat_box()
        self._add_message(text, is_user=True)
        thinking_label = self._add_message(_("Thinking…"), is_user=False, is_thinking=True)
        GLib.idle_add(self._scroll_to_bottom)

        def worker():
            is_error = False

            def on_partial(partial_text):
                GLib.idle_add(self._on_partial_reply, thinking_label, partial_text)

            try:
                reply = query_assistant(
                    text, history_at_send, self._request_approval, on_partial_reply=on_partial
                )
            except (TimeoutError, socket.timeout):
                # Streaming turned this into a genuine idle timeout (see
                # LLAMA_STREAM_IDLE_TIMEOUT_SECONDS) -- this now means the
                # connection actually stalled with no data at all for that
                # long, not just "a slow reply", since a slow-but-still-
                # arriving reply keeps resetting the timer on its own.
                reply = _(
                    "Sorry, the assistant stopped responding. This can happen if "
                    "llama-server has crashed or hung. Try asking again; if it keeps "
                    "happening, the assistant may need to be restarted."
                )
                is_error = True
            except urllib.error.HTTPError as exc:
                # HTTPError is a URLError subclass, so this must be caught
                # ahead of the plain URLError handler below. str(exc) alone
                # is just the status line ("HTTP Error 400: Bad Request")
                # -- llama-server puts the actual reason in the response
                # body (e.g. a specific validation error), which is lost
                # if it isn't read here. Worth surfacing for real
                # diagnosis rather than a dead-end generic message.
                try:
                    detail = exc.read().decode("utf-8", errors="replace").strip()
                except Exception:
                    detail = ""
                # A real, confirmed failure mode (not hypothetical): the
                # fixed per-request overhead (system prompt + all tool
                # schemas) plus a long-running conversation's own history
                # can exceed the context window -- llama-server rejects
                # this with a 400 whose body mentions the context size, a
                # distinct and actionable case worth a specific message for
                # rather than a generic error, since raising the context
                # window (see LlamaServerManager.start) only pushes the
                # ceiling out, it doesn't remove it.
                if "context" in detail.lower() and (
                    "exceed" in detail.lower() or "size" in detail.lower()
                ):
                    reply = _(
                        "Sorry, this conversation has gotten long enough that the assistant "
                        "has run out of memory for it. Try starting a New Chat to continue."
                    )
                else:
                    reply = _("Sorry, something went wrong: HTTP {code} {reason}{detail}").format(
                        code=exc.code,
                        reason=exc.reason,
                        detail=f" -- {detail}" if detail else "",
                    )
                is_error = True
            except urllib.error.URLError as exc:
                if isinstance(exc.reason, (TimeoutError, socket.timeout)):
                    reply = _(
                        "Sorry, the assistant stopped responding. This can happen if "
                        "llama-server has crashed or hung. Try asking again; if it keeps "
                        "happening, the assistant may need to be restarted."
                    )
                else:
                    reply = _("Sorry, something went wrong: {error}").format(error=exc)
                is_error = True
            except Exception as exc:
                reply = _("Sorry, something went wrong: {error}").format(error=exc)
                is_error = True
            GLib.idle_add(
                self._on_reply,
                text,
                reply,
                thinking_label,
                is_error,
                conv_id_at_send,
                history_at_send,
            )

        threading.Thread(target=worker, daemon=True).start()

    def _request_approval(self, action_description):
        """Called from the background worker thread. Blocks that thread
        (never the GTK main loop) until the user answers a real dialog --
        every gated action asks every time, no "always allow"."""
        result = {}
        done = threading.Event()

        def show_dialog():
            result["allowed"] = self._show_confirm_dialog(
                _("Allow this action?"),
                _("The assistant wants to {action}.").format(action=action_description),
                _("Allow"),
            )
            done.set()
            return False

        GLib.idle_add(show_dialog)
        # No timeout, deliberately. The old 120s wait created a desync: a
        # user still reading the dialog past two minutes had the worker
        # give up behind their back ("user did not approve"), so their
        # eventual Allow click closed the dialog and did nothing --
        # silently. Blocking indefinitely is safe here: this runs on a
        # daemon worker thread, never the GTK main loop, and the modal
        # dialog on screen is exactly what the user is being waited on
        # for. The dialog cannot leak -- destroy_with_parent closes it if
        # the window goes away, and closing it (Escape/Cancel/X) always
        # sets the event.
        done.wait()
        return result.get("allowed", False)

    def _on_partial_reply(self, thinking_label, partial_text):
        """Called (via GLib.idle_add, so already on the main thread) for
        every streamed content fragment -- grows the reply in place
        instead of leaving a static "Thinking..." up for however long
        generation takes. Deliberately not run through
        _strip_latex_artifacts here -- that regex expects complete LaTeX
        commands, and matching against a fragment mid-command (e.g. text
        ending in "\\tex") could produce a wrong or flickering partial
        result; the final call in _on_reply below does the real cleanup
        once the full text is in.
        """
        if thinking_label.get_parent() is None:
            # The bubble was destroyed (view cleared) -- navigation is frozen
            # during generation so this shouldn't happen, but a destroyed
            # widget must never be touched regardless.
            return False
        thinking_label.set_text(_wrap_message_text(partial_text))
        self._scroll_to_bottom()
        return False

    def _on_reply(self, user_text, reply, thinking_label, is_error, conv_id_at_send, history_at_send):
        if thinking_label.get_parent() is not None:
            pulsing_logo = getattr(thinking_label, "pulsing_logo", None)
            if pulsing_logo is not None:
                pulsing_logo.hide()
            column = getattr(thinking_label, "message_column", None)
            if column is None or is_error:
                # An error string is plain prose with no formatting to gain,
                # and losing the message entirely because rendering tripped
                # over it would be much worse than showing it unstyled.
                thinking_label.set_text(_wrap_message_text(reply))
                style = thinking_label.get_style_context()
                style.remove_class("message-thinking")
                style.add_class("message-assistant")
            else:
                # Swap the plain streaming label for the rendered body. The
                # role label is the column's first child and stays; every
                # widget after it belonged to the in-progress reply.
                children = column.get_children()
                for child in children[1:]:
                    column.remove(child)
                    child.destroy()
                column.pack_start(self._render_message_body(reply), False, False, 0)
                column.show_all()

        # A failed turn (timeout, connection error, etc.) stays visible in
        # the chat transcript above (the bubble is already on screen) but
        # must NOT be added to history or persisted -- confirmed this was
        # happening and causing a real, observed follow-on failure: after a
        # timeout, "Sorry, something went wrong: timed out" was saved as if
        # it were the assistant's genuine turn, so a follow-up "continue"
        # sent that fake turn back to the model as real context, with
        # nothing actual to continue from. Treating a failed exchange as if
        # it never happened (from the model's point of view) is the correct
        # fix, not just a longer timeout -- the user's own question stays
        # visible on screen either way since that bubble doesn't depend on
        # self.history at all.
        if not is_error:
            # Append and save against the conversation captured at send time
            # (see on_send) -- NOT self.history/self.current_conv_id, which
            # belong to whatever the user is looking at now. With navigation
            # frozen they are the same thing; the capture keeps a completed
            # exchange from ever being filed into the wrong conversation if
            # that freeze is ever loosened.
            history_at_send.append({"role": "user", "content": user_text})
            history_at_send.append({"role": "assistant", "content": reply})

            # Persist after every completed turn, not just on switch/close, so a
            # crash or force-quit never loses more than the in-flight reply (see
            # the "Conversation persistence" section comment for why one file
            # per conversation). First reply of a fresh chat mints its id here,
            # not at chat-start, so quitting without sending anything never
            # leaves an empty conversation cluttering the sidebar.
            if conv_id_at_send is None:
                conv_id_at_send = uuid.uuid4().hex[:12]
                if self.current_conv_id is None:
                    self.current_conv_id = conv_id_at_send
            try:
                _save_conversation(
                    conv_id_at_send, _make_title(history_at_send[0]["content"]), history_at_send
                )
                self._refresh_conversation_list()
            except Exception as exc:
                # A failed save (disk full is the realistic case on this
                # hardware) must never take the input box down with it --
                # this except is what keeps the re-enables below reachable.
                # The exchange is still in memory, and every later turn
                # rewrites the whole history, so the next save that
                # succeeds heals this one. Surface it instead of logging
                # silently: the user should know their history isn't
                # landing on disk.
                self._add_message(
                    _(
                        "Warning: this conversation could not be saved "
                        "({error}). It stays on screen, but may be lost when "
                        "the assistant is closed. The disk may be full."
                    ).format(error=exc),
                    is_user=False,
                )

        self.entry.set_sensitive(True)
        self.send_button.set_sensitive(True)
        self.attach_button.set_sensitive(True)
        self.new_chat_button.set_sensitive(True)
        self.conversation_list.set_sensitive(True)
        self.entry.grab_focus()
        GLib.idle_add(self._scroll_to_bottom)
        return False

    def on_destroy(self, *_args):
        self.server.stop()
        Gtk.main_quit()


def main():
    provider = Gtk.CssProvider()
    provider.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_screen(
        Gdk.Screen.get_default(),
        provider,
        Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
    )

    win = AssistantWindow()
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    # --prewarm: headless mode used by venu-pacific-llama-prewarm.service
    # at login. Evaluates the fixed system-prompt + tool-schema prefix
    # into the (login-started) server's KV cache in the background,
    # BEFORE the user ever opens this app -- without it, the first
    # message after every boot paid the full ~2-minute prefix eval while
    # the user watched "Thinking...", confirmed annoying in practice
    # across repeated real sessions. No GTK window is created in this
    # mode, so it runs fine from a systemd user service with no display
    # assumptions. Waits for the server to be ready first (the service
    # may still be loading the model when this fires at login).
    if "--prewarm" in sys.argv:
        # Retry rather than one-shot. Observed for real: the server was
        # crash-restarting (port contention) while this ran, /health
        # answered once from a dying instance, the single prewarm attempt
        # then failed on a dropped connection, and the exception was
        # swallowed -- so this service exited "successfully" having warmed
        # NOTHING, and the user still paid the full 222s prefix
        # evaluation on their first message. Now it confirms the warm-up
        # actually completed, and keeps trying across restarts until it
        # does or the overall budget runs out.
        overall_deadline = time.time() + PREWARM_TOTAL_BUDGET_SECONDS
        while time.time() < overall_deadline:
            remaining = overall_deadline - time.time()
            if not _wait_for_server(min(STARTUP_TIMEOUT_SECONDS, remaining)):
                break
            if prewarm_prefix():
                sys.exit(0)
            # Warm-up attempt failed (server died mid-request, most
            # likely) -- pause briefly so a systemd restart can land,
            # then try again rather than declaring false success.
            time.sleep(5)
        sys.exit(1)
    main()
