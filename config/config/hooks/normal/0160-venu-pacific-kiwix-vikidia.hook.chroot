#!/bin/sh
# Bundles Vikidia (a Wikipedia-style encyclopedia written for children,
# ages 8-13) directly into the image -- unlike every other Kiwix ZIM file
# we looked at (1.8-4.2GB+), Vikidia with images is only ~103MB, a
# negligible size increase, so it's worth shipping with zero setup rather
# than adding it to kiwix-content/'s download-later guide.
#
# Downloaded at build time rather than committed to git (a 103MB binary
# doesn't belong in version control). If this exact dated file 404s in a
# future rebuild, check https://library.kiwix.org for the current Vikidia
# release and update the filename below.
set -e

DEST_DIR="/usr/share/venu-pacific/kiwix-content"
mkdir -p "$DEST_DIR"

wget -q \
    "https://download.kiwix.org/zim/vikidia/vikidia_en_all_maxi_2026-06.zim" \
    -O "$DEST_DIR/vikidia.zim"

# Kiwix publishes a .sha256 sidecar next to every ZIM -- this hash is
# from vikidia_en_all_maxi_2026-06.zim.sha256 (retrieved 2026-07-30).
# A corrupt ZIM otherwise only fails when a user first opens it. Bump
# together with the filename above.
echo "6de94f77c36ce6ca9656c6aef77b3f4e38e736a27470b14eb9c4e887ad4b5425  $DEST_DIR/vikidia.zim" \
    | sha256sum -c -

# Bislama content (added 2026-08-01, from the content-sourcing research
# -- see docs/content-sourcing.md). Two tiny ZIMs, ~21MB combined:
#
# - The Bislama Wikipedia: the only Bislama-language encyclopedia in
#   existence, 16.6MB with images. CC BY-SA.
# - PhET science simulations with a Bislama interface, 4.4MB. CC BY 4.0.
#
# Filenames double as the collection names the AI assistant shows for
# its offline-search tool (it maps every *.zim basename in this
# directory), so they are descriptive rather than the upstream dated
# names. Hashes from Kiwix's own .sha256 sidecars, retrieved 2026-08-01.
wget -q \
    "https://download.kiwix.org/zim/wikipedia/wikipedia_bi_all_maxi_2026-07.zim" \
    -O "$DEST_DIR/wikipedia-bislama.zim"
echo "c261a19d841d7016e25533fb355bd19cfb78a7dcd082209fe2c6e41f447df049  $DEST_DIR/wikipedia-bislama.zim" \
    | sha256sum -c -

wget -q \
    "https://download.kiwix.org/zim/phet/phet_bi_all_2026-05.zim" \
    -O "$DEST_DIR/phet-bislama.zim"
echo "d9d2a0f426f15373982d65c0d1a886821c38dc402c7f2e673710af7660445d07  $DEST_DIR/phet-bislama.zim" \
    | sha256sum -c -
