#!/bin/sh
# Launches Kolibri (offline courses/learning materials) and opens it in
# the browser -- Kolibri is itself a local Django web server, same shape
# as kiwix-serve, not a native GTK app, so this is a start-then-open
# wrapper rather than a real application.
#
# PEX_ROOT and KOLIBRI_HOME are both left at their own defaults
# (~/.pex and ~/.kolibri) -- per-user, always writable by that user, no
# permissions complexity. PEX_ROOT extracts its bundled dependencies
# there on first launch only (~4s, confirmed directly); tried redirecting
# it to a shared pre-warmed cache and confirmed that backfires (PEX needs
# write access even to reuse an already-extracted cache, so a read-only
# shared one causes it to silently re-extract from scratch on *every*
# launch instead) -- not worth it for a few-second, one-time, per-user
# cost. See 0180-venu-pacific-kolibri.hook.chroot for the full story.
#
# Deliberately NO `set -e`: this runs from a Terminal=false .desktop
# entry, so an unexplained early exit means "clicking Learn does
# nothing" -- the user gets zero feedback and no way to know why. Every
# failure path below ends in a visible dialog instead.

KOLIBRI_BIN="/opt/venu-pacific/kolibri/kolibri.pex"
KOLIBRI_URL="http://127.0.0.1:8080"
LOG="${XDG_CACHE_HOME:-$HOME/.cache}/venu-pacific-learn.log"

mkdir -p "$(dirname "$LOG")" 2>/dev/null

fail() {
    # zenity ships with the XFCE desktop; notify-send (libnotify-bin, on
    # the package list) as fallback; xmessage as the last resort that is
    # effectively always present on an X system.
    if command -v zenity >/dev/null 2>&1; then
        zenity --error --title="Learn" --text="$1" 2>/dev/null
    elif command -v notify-send >/dev/null 2>&1; then
        notify-send -u critical "Learn" "$1"
    elif command -v xmessage >/dev/null 2>&1; then
        xmessage "$1"
    fi
    exit 1
}

# Is something already answering on the port?
#
# This replaces an earlier `kolibri status` check, which was the wrong
# question and produced a wrong answer at the worst moment. status exits
# non-zero both when Kolibri is stopped AND while it is still starting up,
# and startup takes 20-40s on the hardware this targets. So a second click
# during startup -- exactly what an impatient user does when the first
# click appears to do nothing -- was read as "not running", started a
# second server, and Kolibri rightly refused with "There is another
# Kolibri server running". The user then saw "could not start, try
# restarting the computer" about a server that was working perfectly and
# about to open. Confirmed from a real ~/.kolibri/logs/kolibri.txt during
# pilot testing.
#
# "Is it serving HTTP?" is the only thing this script actually needs to
# know, it has exactly one answer, and it is true precisely when the next
# step (open the browser) will work.
serving() {
    wget -q --spider -T 2 "$KOLIBRI_URL" 2>/dev/null
}

[ -x "$KOLIBRI_BIN" ] || fail "The Learn app is not installed correctly (missing $KOLIBRI_BIN). Please report this."

if ! serving; then
    # Not answering yet: either stopped, or already starting from an
    # earlier click. Attempt a start either way -- if one is already
    # coming up this is refused harmlessly, and the wait loop below is
    # what decides whether we succeeded. Deliberately NOT fatal on
    # non-zero: "another server is already starting" is a success from
    # the user's point of view, and treating it as failure is the bug
    # this rewrite exists to remove.
    {
        echo "--- $(date -Is) starting Kolibri"
        "$KOLIBRI_BIN" start --background --port 8080
        echo "--- start exited $?"
    } >>"$LOG" 2>&1
fi

# Wait until the server actually answers HTTP before opening the browser.
# `start --background` returns before the web server is serving, and the
# very first launch also runs database setup -- slow on the low-spec
# hardware this targets. Without this wait, the user's first-ever
# experience of Learn is Firefox's "Unable to connect" page with no hint
# that a simple reload would fix it. 120s budget: generous for first-run
# DB migration on a slow disk, and the loop exits the moment the server
# responds.
tries=0
until serving; do
    tries=$((tries + 1))
    if [ "$tries" -ge 120 ]; then
        fail "The Learn app is taking too long to start.

Please try again in a minute. If it keeps happening, the details are in:
$LOG"
    fi
    sleep 1
done

exec firefox-esr "$KOLIBRI_URL"
